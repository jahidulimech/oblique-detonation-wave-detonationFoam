FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (2798.99 -855.74 0);

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform (2798.99 -855.74 0);
    }
    top
    {
        type            fixedValue;
        value           uniform (2798.99 -855.74 0);
    }
    outlet
    {
        type            zeroGradient;
    }
    bottomOutlet
    {
        type            zeroGradient;
    }
    wedge
    {
        type            slip;
    }
    frontAndBack
    {
        type            empty;
    }
}
