FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    location        "constant";
    object          chemistryProperties;
}

refmapping
{
}

loadbalancing
{
    active          true;
    log             false;
}

chemistry       on;
initialChemicalTimeStep 1e-10;

chemistryType
{
    solver          ode;
    method          loadBalanced;
}

odeCoeffs
{
    solver          seulex;
    absTol          1e-08;
    relTol          1e-04;
}

#include "$FOAM_CASE/constant/foam/reactions.foam"

differentialDiffusion off;
thermalDiffusion off;

Prt  Prt [0 0 0 0 0] 0.7;
Sct  Sct [0 0 0 0 0] 0.7;
